{
  "name": "vue-i18n-kit",
  "version": "0.4.8",
  "description": "Vue 3 i18n layer over vue-i18n with lazy locale loading, composables, a Vite plugin and a CLI for extracting and managing translations.",
  "author": "macrulez <macrulezru@gmail.com> (https://macrulez.ru/en)",
  "license": "MIT",
  "homepage": "https://npm.vuecraft.ru/en/packages/vue-i18n-kit/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/macrulezru/vue-i18n-kit.git"
  },
  "bugs": {
    "url": "https://github.com/macrulezru/vue-i18n-kit/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "bin": {
    "vue-i18n-kit": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite-plugin/index.d.ts",
      "import": "./dist/vite-plugin/index.mjs",
      "require": "./dist/vite-plugin/index.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "import": "./dist/config/index.mjs",
      "require": "./dist/config/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepublishOnly": "npm run build",
    "prebuild": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsup && vite build --config vite.config.dev-overlay.mts && vite build --config vite.config.ui.mts",
    "dev": "tsup --watch",
    "dev:ui": "vite dev --config vite.config.ui.mts",
    "dev:overlay": "vite build --watch --config vite.config.dev-overlay.mts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "demo": "npm run build && npm --prefix demo install && npm --prefix demo run dev",
    "demo:full": "npm run build && npm --prefix demo install && npm --prefix demo run dev:full"
  },
  "peerDependencies": {
    "vite": ">=5.0.0",
    "vue": "^3.3.0",
    "vue-i18n": "^11.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.17.14",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^15.7.4",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "vite": "^5.4.14",
    "vitest": "^2.1.8",
    "vue": "^3.5.13",
    "vue-i18n": "^11.4.5"
  },
  "keywords": [
    "vue",
    "vue3",
    "i18n",
    "localization",
    "vue-i18n",
    "lazy-loading",
    "vite-plugin",
    "cli",
    "typescript"
  ],
  "dependencies": {
    "@clack/prompts": "^1.2.0"
  }
}
